@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title MaquiGest - Software Architecture Context Diagram

Person(rentalOperator, "Rental Operator", "Manages machinery, rental requests, reservations, deliveries, returns, incidents, and maintenance for a rental company.")
Person(constructionManager, "Construction Manager", "Searches machinery, checks availability, submits rental requests, and monitors reservations and active rentals for construction projects.")
Person(systemAdministrator, "System Administrator", "Administers platform access, supervises platform operations, and resolves exceptional operational cases.")

System(maquigest, "MaquiGest", "Web-based SaaS platform that supports the complete lifecycle of construction machinery rental.")

System_Ext(googleMaps, "Google Maps Platform", "Provides mapping and geolocation services.")
System_Ext(stripe, "Stripe", "Processes subscription payments.")
System_Ext(sendGrid, "SendGrid", "Sends transactional emails and notifications.")

Rel(rentalOperator, maquigest, "Manages equipment and rental operations", "HTTPS")
Rel(constructionManager, maquigest, "Searches equipment and manages rental requests", "HTTPS")
Rel(systemAdministrator, maquigest, "Administers platform access and supervises operations", "HTTPS")

Rel(maquigest, googleMaps, "Requests mapping and geolocation services", "HTTPS/REST")
Rel(maquigest, stripe, "Processes subscription payments", "HTTPS/API")
Rel(maquigest, sendGrid, "Sends transactional emails and notifications", "HTTPS/API")

@enduml