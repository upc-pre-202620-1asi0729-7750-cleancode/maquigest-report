@startuml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title MaquiGest - Maintenance Frontend Components Diagram

Container_Boundary(maintenanceContext, "Maintenance Frontend Bounded Context\n[Angular Bounded Context Module]") {

    Component(presentationLayer, "Presentation Layer", "Pages / Components / Routes", "Renders maintenance schedules, inspections, incidents, maintenance details, and equipment history views.")

    Component(applicationLayer, "Application Layer", "Facades / Services", "Coordinates maintenance workflows, incident reporting, inspections, maintenance state, and frontend use cases.")

    Component(infrastructureLayer, "Infrastructure Layer", "API Clients / Mappers", "Consumes Maintenance backend endpoints and maps maintenance resources into frontend models.")

    Component(domainLayer, "Domain Layer", "Models / Rules", "Defines maintenance, inspection, incident, maintenance status, and equipment history models and frontend rules.")
}

Container_Ext(inventoryContext, "Inventory", "Frontend Context", "Provides equipment information and receives maintenance-related availability and status updates.")

Container_Ext(rentalsContext, "Rentals", "Frontend Context", "Provides active rental context when incidents or maintenance events affect rented equipment.")

Container_Ext(sharedFrontend, "Shared Frontend", "Shared UI / Session", "Provides reusable UI primitives, session utilities, guards, and shared frontend services.")

Container_Ext(backendApi, "MaquiGest Backend API", "External Container", "REST API consumed by the Maintenance frontend context.")

Rel(presentationLayer, applicationLayer, "Dispatches UI actions")

Rel(applicationLayer, infrastructureLayer, "Requests maintenance data")
Rel(applicationLayer, domainLayer, "Applies maintenance and incident rules")

Rel(applicationLayer, inventoryContext, "Uses and updates equipment status")
Rel(applicationLayer, rentalsContext, "Uses active rental context")

Rel(presentationLayer, sharedFrontend, "Uses layout / UI primitives")
Rel(applicationLayer, sharedFrontend, "Uses shared services")

Rel(infrastructureLayer, backendApi, "Consumes Maintenance REST endpoints", "JSON / HTTPS")

SHOW_LEGEND()

@enduml