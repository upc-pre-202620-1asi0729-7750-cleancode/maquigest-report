@startuml
!include _includes/C4_Component.puml
title MaquiGest - Inventory Backend Component Diagram
Container(spa, "MaquiGest Web Application", "Angular", "Inventory REST client")
Container_Ext(iam, "IAM Bounded Context", "Published IAM contracts", "Provides authenticated actor identity.")
Container_Ext(rentals, "Rentals Bounded Context", "Backend context", "Consumes the inventory rental facade.")
Container_Ext(maintenance, "Maintenance Bounded Context", "Backend context", "Consumes the inventory maintenance facade.")
Container_Boundary(inventory, "Inventory Bounded Context [Java / Spring Boot]") {
 Component(rest, "Inventory REST Interface", "EquipmentController / EquipmentCategoriesController", "Exposes equipment, category, availability and status operations.")
 Component(policy, "Inventory Ownership Policy", "InventoryOwnershipPolicy", "Checks equipment ownership with IAM.")
 Component(app, "Inventory Command and Query Services", "Equipment and category services", "Coordinates inventory use cases.")
 Component(facades, "Published Inventory Facades", "InventoryRentalFacade / InventoryMaintenanceFacade", "Exposes controlled inventory capabilities to Rentals and Maintenance.")
 Component(domain, "Inventory Domain", "Equipment / AvailabilityBlock / EquipmentCategory / RentalRate", "Enforces reservation, availability and operational-state rules.")
 Component(repoPorts, "Domain Repository Ports", "EquipmentRepository / EquipmentCategoryRepository", "Defines persistence contracts owned by Domain.")
 Component(persistence, "Inventory Persistence Adapters", "RepositoryImpl / assemblers / JPA", "Implements inventory repository ports.")
 Component(seed, "Category Seeder", "InventoryApplicationReadyEventHandler", "Seeds required equipment categories.")
}
ContainerDb(db, "MaquiGest Database", "MySQL", "Inventory tables")
Rel(spa, rest, "Calls", "JSON/HTTPS")
Rel(rest, policy, "Authorizes through")
Rel(policy, iam, "Reads actor identity")
Rel(policy, repoPorts, "Checks equipment owner")
Rel(rest, app, "Delegates")
Rel(app, domain, "Executes")
Rel(app, repoPorts, "Uses")
Rel(facades, domain, "Executes aggregate behavior")
Rel(facades, repoPorts, "Locks and persists equipment")
Rel(rentals, facades, "Checks, reserves and releases equipment")
Rel(maintenance, facades, "Inspects and changes equipment status")
Rel(persistence, repoPorts, "Implements")
Rel(persistence, db, "Reads and writes", "JPA/SQL")
Rel(seed, app, "Seeds categories")
SHOW_LEGEND()
@enduml
