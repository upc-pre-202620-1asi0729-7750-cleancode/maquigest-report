
@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title MaquiGest - Inventory Backend Component Diagram

Container_Boundary(inventory, "Inventory Bounded Context [Java / Spring Boot]") {

    Boundary(interfaces_layer, "Interfaces Layer") {
        Component(rest, "rest", "REST API Package", "Equipment and category endpoints. Subpackages: resources, security, transform.")
        Component(published_acl, "acl", "Published Inventory Contracts", "Exposes equipment capabilities to Rentals and Maintenance.")
    }

    Boundary(application_layer, "Application Layer") {
        Component(commands, "commandservices", "Application Contracts", "Defines equipment and category commands.")
        Component(queries, "queryservices", "Application Contracts", "Defines equipment and category queries.")
        Component(internal_services, "internal", "Use Case Implementations", "Subpackages: commandservices, queryservices. Coordinates inventory operations.")
        Component(event_handlers, "internal.eventhandlers", "Application Event Handling", "Initializes the equipment category catalog.")
        Component(application_acl, "acl", "Inventory Facade Implementations", "Implements the published inventory contracts.")
    }

    Boundary(domain_layer, "Domain Layer") {
        Component(domain_model, "model", "Domain Model", "Subpackages: aggregates, commands, entities, queries, valueobjects. Owns inventory business rules.")
        Component(domain_repositories, "repositories", "Repository Contracts", "Defines equipment and category persistence operations.")
    }

    Boundary(infrastructure_layer, "Infrastructure Layer") {
        Component(jpa, "persistence.jpa", "JPA Persistence", "Subpackages: adapters, assemblers, entities, repositories. Maps and persists inventory data.")
    }
}

Rel(rest, commands, "Invokes commands")
Rel(rest, queries, "Invokes queries")
Rel(internal_services, commands, "Implements command contracts")
Rel(internal_services, queries, "Implements query contracts")
Rel(internal_services, domain_model, "Applies inventory rules")
Rel(internal_services, domain_repositories, "Uses repositories")

Rel(event_handlers, commands, "Seeds equipment categories")
Rel(application_acl, published_acl, "Implements published contracts")
Rel(application_acl, domain_repositories, "Accesses inventory")

Rel(jpa, domain_repositories, "Implements repository contracts")

Lay_D(rest, commands)
Lay_D(commands, domain_model)
Lay_D(domain_model, jpa)

SHOW_LEGEND()

@enduml