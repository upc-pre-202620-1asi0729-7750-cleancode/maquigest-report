@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title MaquiGest - Backend Bounded Contexts Overview

Container(spa, "MaquiGest Web Application", "Angular", "Provides the browser-based user interface.")

ContainerDb(db, "MaquiGest Database", "MySQL", "Stores persistent bounded-context data.")

Container_Boundary(backend, "MaquiGest Backend API [Java / Spring Boot]") {

    Boundary(contexts, "Business Bounded Contexts") {

        Component(iam, "IAM Bounded Context", "Identity and Access Management", "Authentication, authorization, users, roles and identity contracts.")

        Component(profiles, "Profiles Bounded Context", "Company Profiles", "Company information, contact details and addresses.")

        Component(inventory, "Inventory Bounded Context", "Equipment Management", "Equipment, categories, rental rates and availability.")

        Component(rentals, "Rentals Bounded Context", "Rental Management", "Rental requests, reservations, deliveries and returns.")

        Component(maintenance, "Maintenance Bounded Context", "Maintenance Management", "Equipment incidents, maintenance records and activities.")

        Component(subscriptions, "Subscriptions Bounded Context", "Subscription Management", "Subscription plans, memberships and entitlements.")
    }

    Component(shared, "Shared Module", "Shared Technical Support", "Common results, errors, auditing and event support.")
}

Rel(spa, backend, "Consumes backend REST APIs", "JSON/HTTPS")

Rel(backend, db, "Persists bounded-context data", "JPA/SQL")

Rel(profiles, iam, "Uses account identity")

Rel(inventory, iam, "Resolves owner identity")

Rel(subscriptions, iam, "Resolves subscriber identity")

Rel(rentals, inventory, "Checks equipment availability")

Rel(rentals, subscriptions, "Checks rental entitlements")

Rel(maintenance, inventory, "Coordinates equipment availability")

Rel(maintenance, rentals, "Checks active rentals")


Rel(maintenance, shared, "Uses shared results and error handling")


SHOW_LEGEND()

@enduml