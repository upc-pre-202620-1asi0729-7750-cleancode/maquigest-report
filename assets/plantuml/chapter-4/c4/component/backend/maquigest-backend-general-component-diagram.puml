@startuml
!include _includes/C4_Component.puml
LAYOUT_TOP_DOWN()
AddElementTag("Interfaces", $bgColor="#D6EAF8", $borderColor="#2471A3")
AddElementTag("Application", $bgColor="#D5F5E3", $borderColor="#1E8449")
AddElementTag("Domain", $bgColor="#FCF3CF", $borderColor="#B7950B")
AddElementTag("Infrastructure", $bgColor="#F5EEF8", $borderColor="#7D3C98")
title MaquiGest - Backend Layered Components and Context Map

Container(spa, "MaquiGest Web Application", "Angular", "Consumes the backend REST API.")
ContainerDb(db, "MaquiGest Database", "MySQL", "Persists bounded-context data in context-owned tables.")
System_Ext(shared, "Shared Module", "Result, ApplicationError, auditing and in-process event support.")

Container_Boundary(backend, "MaquiGest Backend API [Java / Spring Boot]") {
  Boundary(iam_bc, "IAM Bounded Context") {
    Component(iam_int, "Interfaces Layer", "REST / identity facades", "Exposes authentication endpoints and published identity contracts.", $tags="Interfaces")
    Component(iam_app, "Application Layer", "command services / ports / facade implementations", "Coordinates authentication, role seeding and identity projections.", $tags="Application")
    Component(iam_dom, "Domain Layer", "User / Role / commands / repositories", "Owns account rules, roles and persistence contracts.", $tags="Domain")
    Component(iam_inf, "Infrastructure Layer", "Spring Security / JWT / BCrypt / JPA", "Implements security, projection and persistence adapters.", $tags="Infrastructure")
  }
  Boundary(profiles_bc, "Profiles Bounded Context") {
    Component(profiles_int, "Interfaces Layer", "REST / policies / integration contract", "Exposes profile operations and published events.", $tags="Interfaces")
    Component(profiles_app, "Application Layer", "command-query services / IAM port", "Coordinates profile use cases and identity requirements.", $tags="Application")
    Component(profiles_dom, "Domain Layer", "CompanyProfile / value objects / events / repository", "Owns company-profile rules and persistence contract.", $tags="Domain")
    Component(profiles_inf, "Infrastructure Layer", "JPA / IAM ACL / reconciler / event bridge", "Implements persistence, integration and profile reconciliation.", $tags="Infrastructure")
  }
  Boundary(inventory_bc, "Inventory Bounded Context") {
    Component(inventory_int, "Interfaces Layer", "REST / policies / published facades", "Exposes inventory operations and controlled context contracts.", $tags="Interfaces")
    Component(inventory_app, "Application Layer", "command-query services / facade implementations", "Coordinates equipment, category and cross-context operations.", $tags="Application")
    Component(inventory_dom, "Domain Layer", "Equipment / Category / value objects / repositories", "Owns availability, status and inventory persistence rules.", $tags="Domain")
    Component(inventory_inf, "Infrastructure Layer", "JPA adapters / entities / assemblers", "Implements inventory persistence mappings.", $tags="Infrastructure")
  }
  Boundary(rentals_bc, "Rentals Bounded Context") {
    Component(rentals_int, "Interfaces Layer", "REST / policies / maintenance facade", "Exposes rental operations and maintenance-facing contract.", $tags="Interfaces")
    Component(rentals_app, "Application Layer", "services / transactional executors / external ports", "Coordinates rental lifecycle and cross-context capabilities.", $tags="Application")
    Component(rentals_dom, "Domain Layer", "Rental aggregates / records / value objects / events / repositories", "Owns request and rental lifecycle rules.", $tags="Domain")
    Component(rentals_inf, "Infrastructure Layer", "JPA / ACL / concurrency guard / event bridge", "Implements persistence, integration and event translation.", $tags="Infrastructure")
  }
  Boundary(maintenance_bc, "Maintenance Bounded Context") {
    Component(maintenance_int, "Interfaces Layer", "REST / policies / error boundary / event contract", "Exposes maintenance operations and integration events.", $tags="Interfaces")
    Component(maintenance_app, "Application Layer", "services / transactional executors / external ports", "Coordinates incidents, maintenance and context integrations.", $tags="Application")
    Component(maintenance_dom, "Domain Layer", "Incident / Maintenance / activity / value objects / events / repositories", "Owns incident and maintenance lifecycle rules.", $tags="Domain")
    Component(maintenance_inf, "Infrastructure Layer", "JPA / ACL / event bridge", "Implements persistence, external ports and event translation.", $tags="Infrastructure")
  }
  Boundary(subscriptions_bc, "Subscriptions Bounded Context") {
    Component(subscriptions_int, "Interfaces Layer", "REST / ownership policy / entitlement facade", "Exposes subscription operations and entitlement decisions.", $tags="Interfaces")
    Component(subscriptions_app, "Application Layer", "command-query services / IAM port / facade implementation", "Coordinates subscription lifecycle and entitlements.", $tags="Application")
    Component(subscriptions_dom, "Domain Layer", "Plan and subscription aggregates / value objects / events / repositories", "Owns plan and subscription lifecycle rules.", $tags="Domain")
    Component(subscriptions_inf, "Infrastructure Layer", "JPA / IAM ACL / plan seed", "Implements persistence, subscriber integration and catalog seeding.", $tags="Infrastructure")
  }
}

Rel(spa, iam_int, "Calls REST endpoints", "JSON/HTTPS")
Rel(iam_int, iam_app, "Invokes use cases")
Rel(iam_app, iam_dom, "Executes domain behavior")
Rel(iam_inf, iam_app, "Implements application ports")
Rel(iam_inf, iam_dom, "Implements repository ports")
Rel(iam_inf, db, "Persists context data", "JPA/SQL")
Rel(iam_app, shared, "Uses shared results/errors")
Rel(spa, profiles_int, "Calls REST endpoints", "JSON/HTTPS")
Rel(profiles_int, profiles_app, "Invokes use cases")
Rel(profiles_app, profiles_dom, "Executes domain behavior")
Rel(profiles_inf, profiles_app, "Implements application ports")
Rel(profiles_inf, profiles_dom, "Implements repository ports")
Rel(profiles_inf, db, "Persists context data", "JPA/SQL")
Rel(profiles_app, shared, "Uses shared results/errors")
Rel(spa, inventory_int, "Calls REST endpoints", "JSON/HTTPS")
Rel(inventory_int, inventory_app, "Invokes use cases")
Rel(inventory_app, inventory_dom, "Executes domain behavior")
Rel(inventory_inf, inventory_dom, "Implements repository ports")
Rel(inventory_inf, db, "Persists context data", "JPA/SQL")
Rel(inventory_app, shared, "Uses shared results/errors")
Rel(spa, rentals_int, "Calls REST endpoints", "JSON/HTTPS")
Rel(rentals_int, rentals_app, "Invokes use cases")
Rel(rentals_app, rentals_dom, "Executes domain behavior")
Rel(rentals_inf, rentals_app, "Implements application ports")
Rel(rentals_inf, rentals_dom, "Implements repository ports")
Rel(rentals_inf, db, "Persists context data", "JPA/SQL")
Rel(rentals_app, shared, "Uses shared results/errors")
Rel(spa, maintenance_int, "Calls REST endpoints", "JSON/HTTPS")
Rel(maintenance_int, maintenance_app, "Invokes use cases")
Rel(maintenance_app, maintenance_dom, "Executes domain behavior")
Rel(maintenance_inf, maintenance_app, "Implements application ports")
Rel(maintenance_inf, maintenance_dom, "Implements repository ports")
Rel(maintenance_inf, db, "Persists context data", "JPA/SQL")
Rel(maintenance_app, shared, "Uses shared results/errors")
Rel(spa, subscriptions_int, "Calls REST endpoints", "JSON/HTTPS")
Rel(subscriptions_int, subscriptions_app, "Invokes use cases")
Rel(subscriptions_app, subscriptions_dom, "Executes domain behavior")
Rel(subscriptions_inf, subscriptions_app, "Implements application ports")
Rel(subscriptions_inf, subscriptions_dom, "Implements repository ports")
Rel(subscriptions_inf, db, "Persists context data", "JPA/SQL")
Rel(subscriptions_app, shared, "Uses shared results/errors")
Rel(profiles_inf, iam_int, "ACL: company identity")
Rel(inventory_int, iam_int, "Published actor identity")
Rel(rentals_int, iam_int, "Published actor identity")
Rel(rentals_inf, inventory_int, "ACL: equipment capabilities")
Rel(rentals_inf, subscriptions_int, "ACL: rental entitlement")
Rel(maintenance_int, iam_int, "Published actor identity")
Rel(maintenance_inf, inventory_int, "ACL: equipment lifecycle")
Rel(maintenance_inf, rentals_int, "ACL: active-rental context")
Rel(maintenance_inf, subscriptions_int, "ACL: maintenance entitlement")
Rel(subscriptions_int, iam_int, "Published actor identity")
Rel(subscriptions_inf, iam_int, "ACL: subscriber identity")

SHOW_LEGEND()
@enduml
