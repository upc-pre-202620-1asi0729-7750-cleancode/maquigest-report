@startuml
!include _includes/C4_Component.puml
title MaquiGest - Backend General Component Diagram
Container(spa, "MaquiGest Web Application", "Angular", "Consumes the backend REST API.")
Container_Boundary(backend, "MaquiGest Platform API [Java 27 / Spring Boot]") {
 Component(iam, "IAM Bounded Context", "Spring Security, JWT, DDD", "Users, roles, authentication, authorization and identity contracts.")
 Component(profiles, "Profiles Bounded Context", "DDD, CQRS, ACL, JPA", "Company profiles and IAM identity reconciliation.")
 Component(inventory, "Inventory Bounded Context", "DDD, CQRS, ACL, JPA", "Equipment, categories, rates, availability and operational status.")
 Component(rentals, "Rentals Bounded Context", "DDD, CQRS, ACL, JPA", "Requests, rentals, deliveries, returns and concurrency control.")
 Component(maintenance, "Maintenance Bounded Context", "DDD, CQRS, ACL, JPA", "Incidents, maintenance lifecycle, activities and equipment history.")
 Component(subscriptions, "Subscriptions Bounded Context", "DDD, CQRS, ACL, JPA", "Plans, subscriptions, entitlement and plan changes.")
 Component(shared, "Shared Kernel", "Result, errors, events, auditing, OpenAPI, i18n", "Cross-cutting contracts and in-process domain-event publication.")
}
ContainerDb(db, "MaquiGest Database", "MySQL", "Stores the data owned by each bounded context.")
Rel(spa, iam, "Authenticates and obtains JWT", "JSON/HTTPS")
Rel(spa, profiles, "Manages company profiles", "JSON/HTTPS")
Rel(spa, inventory, "Manages equipment", "JSON/HTTPS")
Rel(spa, rentals, "Executes rental workflows", "JSON/HTTPS")
Rel(spa, maintenance, "Executes maintenance workflows", "JSON/HTTPS")
Rel(spa, subscriptions, "Manages subscriptions", "JSON/HTTPS")
Rel(profiles, iam, "Reads company identity through published contracts")
Rel(inventory, iam, "Validates equipment owner through actor facade")
Rel(rentals, iam, "Validates rental actor through actor facade")
Rel(maintenance, iam, "Validates maintenance actor through actor facade")
Rel(subscriptions, iam, "Reads subscriber and actor identity")
Rel(rentals, inventory, "Checks, reserves and releases equipment through ACL")
Rel(rentals, subscriptions, "Checks rental entitlement through ACL")
Rel(maintenance, inventory, "Changes equipment state through ACL")
Rel(maintenance, rentals, "Reads active-rental context through ACL")
Rel(maintenance, subscriptions, "Checks maintenance entitlement through ACL")
Rel(iam, shared, "Uses shared result and infrastructure support")
Rel(profiles, shared, "Uses results and domain-event publication")
Rel(inventory, shared, "Uses shared result and infrastructure support")
Rel(rentals, shared, "Uses results and domain-event publication")
Rel(maintenance, shared, "Uses results and domain-event publication")
Rel(subscriptions, shared, "Uses results and domain-event publication")
Rel(iam, db, "Persists IAM data", "JPA/SQL")
Rel(profiles, db, "Persists profile data", "JPA/SQL")
Rel(inventory, db, "Persists inventory data", "JPA/SQL")
Rel(rentals, db, "Persists rental data", "JPA/SQL")
Rel(maintenance, db, "Persists maintenance data", "JPA/SQL")
Rel(subscriptions, db, "Persists subscription data", "JPA/SQL")
SHOW_LEGEND()
@enduml
