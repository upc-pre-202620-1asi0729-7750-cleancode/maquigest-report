@startuml
!include _includes/C4_Component.puml
title MaquiGest - Profiles Backend Component Diagram
Container(spa, "MaquiGest Web Application", "Angular", "Profiles REST client")
Container_Ext(iam, "IAM Bounded Context", "Published IAM contracts", "Provides actor and company identity.")
Container_Ext(shared, "Shared Domain Event Publisher", "Spring ApplicationEventPublisher", "Publishes aggregate events in process.")
Container_Boundary(profiles, "Profiles Bounded Context [Java / Spring Boot]") {
 Component(rest, "Profiles REST Interface", "CompanyProfileController / resources / assemblers", "Exposes profile commands and queries.")
 Component(policy, "Profile Ownership Policy", "ProfileOwnershipPolicy", "Checks ownership with IAM actor identity and profile repository.")
 Component(app, "Profile Command and Query Services", "CompanyProfile services", "Coordinates profile use cases.")
 Component(domain, "Profiles Domain", "CompanyProfile / PersonName / EmailAddress / CompanyAddress", "Enforces company-profile invariants and registers events.")
 Component(repoPort, "Company Profile Repository Port", "CompanyProfileRepository", "Defines persistence operations owned by Domain.")
 Component(iamPort, "IAM Company Directory Port", "IamCompanyDirectoryPort", "Defines the identity data needed by Profiles.")
 Component(iamAdapter, "IAM ACL Adapter", "IamCompanyDirectoryAclAdapter", "Translates IAM published identity into the Profiles port.")
 Component(persistence, "Profile Persistence Adapter", "RepositoryImpl / assembler / JPA", "Implements the profile repository.")
 Component(reconciler, "Profile Reconciler", "CompanyProfilesReconciler", "Creates missing profiles for active IAM company identities.")
 Component(eventBridge, "Profile Event Bridge", "CompanyProfileIntegrationEventBridge", "Translates post-commit domain events into integration events.")
}
ContainerDb(db, "MaquiGest Database", "MySQL", "Company profile data")
Rel(spa, rest, "Calls", "JSON/HTTPS")
Rel(rest, policy, "Authorizes through")
Rel(policy, iam, "Reads actor identity")
Rel(policy, repoPort, "Checks profile ownership")
Rel(rest, app, "Delegates")
Rel(app, domain, "Executes")
Rel(app, repoPort, "Uses")
Rel(app, iamPort, "Uses")
Rel(iamAdapter, iamPort, "Implements")
Rel(iamAdapter, iam, "Calls company directory facade")
Rel(persistence, repoPort, "Implements")
Rel(persistence, db, "Reads and writes", "JPA/SQL")
Rel(persistence, shared, "Publishes aggregate events through")
Rel(shared, eventBridge, "Delivers domain events after commit")
Rel(reconciler, app, "Provisions missing profiles")
SHOW_LEGEND()
@enduml
