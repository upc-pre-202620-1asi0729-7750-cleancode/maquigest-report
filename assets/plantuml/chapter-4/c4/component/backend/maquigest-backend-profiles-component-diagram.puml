
@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title MaquiGest - Profiles Backend Component Diagram

Container_Boundary(profiles, "Profiles Bounded Context [Java / Spring Boot]") {

    Boundary(interfaces_layer, "Interfaces Layer") {
        Component(rest, "rest", "REST API Package", "Exposes company profile endpoints. Subpackages: resources, security, transform.")
        Component(interface_events, "events", "Published Event Contract", "Defines integration events for company profile changes.")
    }

    Boundary(application_layer, "Application Layer") {
        Component(app_commands, "commandservices", "Application Services", "Defines profile commands. internal.commandservices implements the use cases.")
        Component(app_queries, "queryservices", "Application Services", "Defines profile queries. internal.queryservices implements the use cases.")
        Component(app_ports, "ports", "Outbound Application Contracts", "Defines the IAM company directory capabilities required by Profiles.")
    }

    Boundary(domain_layer, "Domain Layer") {
        Component(domain_model, "model", "Domain Model", "Subpackages: aggregates, commands, events, queries, valueobjects. Encapsulates company profile rules.")
        Component(domain_repositories, "repositories", "Domain Repository Contracts", "Defines persistence operations for company profiles.")
    }

    Boundary(infrastructure_layer, "Infrastructure Layer") {
        Component(jpa, "persistence.jpa", "JPA Persistence", "Subpackages: adapters, assemblers, embeddables, entities, repositories.")
        Component(iam_acl, "acl.iam", "Anti-Corruption Layer", "Adapts IAM identity information to the Profiles application port.")
        Component(event_bridge, "events", "Integration Event Adapter", "Translates domain events into integration events after transaction commit.")
        Component(seed, "seed", "Profile Reconciliation", "Creates missing company profiles from IAM accounts at startup and periodically.")
    }
}

Rel(rest, app_commands, "Invokes commands")
Rel(rest, app_queries, "Invokes queries")

Rel(app_commands, domain_model, "Applies domain rules")
Rel(app_queries, domain_repositories, "Queries profiles")

Rel(jpa, domain_repositories, "Implements repository contract")
Rel(iam_acl, app_ports, "Implements IAM directory port")

Rel(event_bridge, interface_events, "Publishes integration events")
Rel(seed, app_commands, "Triggers profile reconciliation")

Lay_D(rest, app_commands)
Lay_D(app_commands, domain_model)
Lay_D(domain_model, jpa)

SHOW_LEGEND()

@enduml