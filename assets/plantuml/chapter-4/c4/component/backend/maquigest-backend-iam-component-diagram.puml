
@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title MaquiGest - IAM Backend Component Diagram

Container_Boundary(iam, "IAM Bounded Context [Java / Spring Boot]") {

    Boundary(interfaces_layer, "Interfaces Layer") {
        Component(rest, "rest", "REST API Package", "Authentication and account endpoints. Subpackages: resources, transform.")
        Component(published_acl, "acl", "Published Identity Contracts", "Exposes actor, company directory and subscriber identity capabilities.")
    }

    Boundary(application_layer, "Application Layer") {
        Component(commands, "commandservices", "Application Contracts", "Defines user and role command operations.")
        Component(internal_commands, "internal.commandservices", "Use Case Implementations", "Coordinates registration, authentication, accounts and roles.")
        Component(event_handlers, "internal.eventhandlers", "Application Event Handling", "Initializes system roles when the application starts.")
        Component(outbound, "internal.outboundservices", "Outbound Service Contracts", "Subpackages: hashing, tokens. Defines password hashing and token operations.")
        Component(ports, "ports", "Application Ports", "Defines company directory and subscriber reading contracts.")
        Component(application_acl, "acl", "Identity Facade Implementations", "Implements the identity contracts published to other contexts.")
    }

    Boundary(domain_layer, "Domain Layer") {
        Component(domain_model, "model", "Domain Model", "Subpackages: aggregates, commands, entities, valueobjects. Owns account and role rules.")
        Component(domain_repositories, "repositories", "Repository Contracts", "Defines user and role persistence operations.")
    }

    Boundary(infrastructure_layer, "Infrastructure Layer") {
        Component(security, "authorization.sfs", "Spring Security", "Subpackages: configuration, model, pipeline, services.")
        Component(bcrypt, "hashing.bcrypt", "Password Hashing Adapter", "Provides BCrypt hashing through its services package.")
        Component(jwt, "tokens.jwt", "Token Adapter", "Provides JWT operations through its services package.")
        Component(jpa, "persistence.jpa", "JPA Persistence", "Subpackages: adapters, assemblers, entities, repositories.")
    }
}

Rel(rest, commands, "Invokes commands")
Rel(internal_commands, commands, "Implements command contract")
Rel(internal_commands, domain_model, "Applies domain rules")
Rel(internal_commands, domain_repositories, "Uses repositories")
Rel(internal_commands, outbound, "Uses hashing and token contracts")

Rel(event_handlers, commands, "Seeds system roles")
Rel(application_acl, published_acl, "Implements published contracts")

Rel(bcrypt, outbound, "Implements hashing contract")
Rel(jwt, outbound, "Implements token contract")
Rel(jpa, domain_repositories, "Implements repository contracts")
Rel(jpa, ports, "Implements identity readers")

Rel(security, jwt, "Validates authentication tokens")

Lay_D(rest, commands)
Lay_D(commands, domain_model)
Lay_D(domain_model, jpa)

SHOW_LEGEND()

@enduml