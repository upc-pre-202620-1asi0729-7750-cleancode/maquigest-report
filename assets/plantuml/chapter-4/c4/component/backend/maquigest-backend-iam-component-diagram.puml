@startuml
!include _includes/C4_Component.puml
title MaquiGest - IAM Backend Component Diagram
Container(spa, "MaquiGest Web Application", "Angular", "IAM REST client")
Container_Boundary(iam, "IAM Bounded Context [Java / Spring Boot]") {
 Component(security, "Security Pipeline", "Spring Security / Bearer filter", "Validates JWT and restores the authenticated principal before controller execution.")
 Component(rest, "IAM REST Interface", "AuthenticationController / AuthenticatedPrincipalController", "Exposes sign-up, sign-in and current-principal operations.")
 Component(commands, "IAM Command Services", "UserCommandService / RoleCommandService", "Coordinates authentication, registration and role seeding.")
 Component(facades, "Published Identity Facades", "IamActorFacade / CompanyDirectory / Subscriber", "Publishes context-neutral identity views to other contexts.")
 Component(domain, "IAM Domain", "User / Role / Roles / UserStatus", "Enforces account and role invariants.")
 Component(repoPorts, "Domain Repository Ports", "UserRepository / RoleRepository", "Defines persistence contracts owned by Domain.")
 Component(persistence, "Persistence Adapters", "RepositoryImpl / assemblers / JPA", "Implements domain repositories and maps IAM data to MySQL.")
 Component(identityReaders, "Identity Read Adapters", "CompanyDirectoryJpaReader / SubscriberJpaReader", "Provides identity projections used by published facades.")
 Component(crypto, "Token and Hashing Adapters", "JJWT / BCrypt", "Implements TokenService and HashingService ports.")
 Component(seed, "Role Seeder", "ApplicationReadyEventHandler", "Seeds required roles through RoleCommandService.")
}
ContainerDb(db, "MaquiGest Database", "MySQL", "IAM tables")
Rel(spa, security, "Sends bearer token", "HTTPS")
Rel(security, rest, "Allows authenticated request")
Rel(rest, commands, "Delegates authentication commands")
Rel(rest, facades, "Reads authenticated actor")
Rel(commands, domain, "Executes domain behavior")
Rel(commands, repoPorts, "Uses")
Rel(commands, crypto, "Uses hashing and token ports")
Rel(facades, repoPorts, "Reads actor aggregate")
Rel(facades, identityReaders, "Reads identity projections")
Rel(persistence, repoPorts, "Implements")
Rel(identityReaders, db, "Queries", "JPA/SQL")
Rel(persistence, db, "Reads and writes", "JPA/SQL")
Rel(security, crypto, "Validates bearer token")
Rel(seed, commands, "Seeds roles")
SHOW_LEGEND()
@enduml
