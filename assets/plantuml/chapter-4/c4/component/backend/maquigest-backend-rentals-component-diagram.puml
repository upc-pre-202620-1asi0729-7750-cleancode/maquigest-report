@startuml
!include _includes/C4_Component.puml
LAYOUT_TOP_DOWN()
AddElementTag("Interfaces", $bgColor="#D6EAF8", $borderColor="#2471A3")
AddElementTag("Application", $bgColor="#D5F5E3", $borderColor="#1E8449")
AddElementTag("Domain", $bgColor="#FCF3CF", $borderColor="#B7950B")
AddElementTag("Infrastructure", $bgColor="#F5EEF8", $borderColor="#7D3C98")
title MaquiGest - Rentals Layered Component Diagram

Container(spa, "MaquiGest Web Application", "Angular", "Consumes Rentals REST endpoints.")
System_Ext(iam, "IAM Actor Contract", "Published actor identity.")
System_Ext(inventory, "Inventory Published Contract", "Equipment availability and reservation facade.")
System_Ext(subscriptions, "Subscriptions Published Contract", "Rental entitlement facade.")
System_Ext(maintenance, "Maintenance Bounded Context", "Consumes rental context.")
System_Ext(shared, "Shared Event Publication", "In-process post-commit event delivery.")
ContainerDb(db, "MaquiGest Database", "MySQL", "Stores rental tables and lock rows.")

Container_Boundary(context, "Rentals Bounded Context") {
  Boundary(interfaces_layer, "Interfaces Layer") {
    Component(rentalsRest, "REST Interface", "request, rental, delivery and return controllers", "Exposes rental request and lifecycle endpoints.", $tags="Interfaces")
    Component(rentalsPolicy, "Actor Policy", "RentalActorPolicy", "Resolves and validates the authenticated actor.", $tags="Interfaces")
    Component(rentalsResources, "Resources and Assemblers", "resources / transform", "Maps HTTP resources and domain results.", $tags="Interfaces")
    Component(rentalsPublished, "Published Maintenance Contract", "RentalsMaintenanceFacade", "Publishes active-rental information and history.", $tags="Interfaces")
    Component(rentalsErrors, "REST Error Boundary", "RentalsExceptionHandler", "Maps application errors to HTTP problem details.", $tags="Interfaces")
    Component(rentalsEventContract, "Integration Event Contract", "RentalIntegrationEvent", "Published language for rental changes.", $tags="Interfaces")
  }
  Boundary(application_layer, "Application Layer") {
    Component(rentalsServices, "Service Contracts", "request/lifecycle command services, query service", "Defines rental use cases.", $tags="Application")
    Component(rentalsCommandImpl, "Command Service Implementations", "RentalRequestCommandServiceImpl, RentalLifecycleCommandServiceImpl", "Converts transactional failures into application results.", $tags="Application")
    Component(rentalsExecutors, "Transactional Executors", "request and lifecycle executors", "Coordinates aggregate and cross-context mutations atomically.", $tags="Application")
    Component(rentalsQueryImpl, "Query Service Implementation", "RentalQueryServiceImpl", "Builds actor-visible rental views.", $tags="Application")
    Component(rentalsPorts, "External Context Ports", "RentalEquipmentPort, RentalSubscriptionPort", "Defines capabilities required from Inventory and Subscriptions.", $tags="Application")
    Component(rentalsFacadeImpl, "Maintenance Facade Implementation", "RentalsMaintenanceFacadeImpl", "Implements the published maintenance contract.", $tags="Application")
  }
  Boundary(domain_layer, "Domain Layer") {
    Component(rentalsAggregates, "Rental Aggregates", "RentalRequest, Rental", "Protects request and rental lifecycle invariants.", $tags="Domain")
    Component(rentalsRecords, "Delivery and Return Records", "Delivery, EquipmentReturn", "Stores immutable lifecycle records identified by rentalId.", $tags="Domain")
    Component(rentalsValues, "Value Objects and Enums", "RentalPeriod, request/rental statuses", "Represents rental periods and lifecycle states.", $tags="Domain")
    Component(rentalsMessages, "Commands and Queries", "rental commands and queries", "Expresses rental mutations and reads.", $tags="Domain")
    Component(rentalsEvents, "Domain Events", "approved, activated and completed events", "Records relevant aggregate transitions.", $tags="Domain")
    Component(rentalsRepos, "Repository Ports", "request, rental, delivery and return repositories", "Defines persistence contracts owned by Domain.", $tags="Domain")
  }
  Boundary(infrastructure_layer, "Infrastructure Layer") {
    Component(rentalsPersistence, "JPA Persistence Adapters", "RepositoryImpl, entities, assemblers", "Implements rental repository ports and mappings.", $tags="Infrastructure")
    Component(rentalsAcl, "ACL Adapters", "InventoryRentalAclAdapter, SubscriptionRentalAclAdapter", "Implements external ports using published facades.", $tags="Infrastructure")
    Component(rentalsGuard, "Submission Concurrency Guard", "InnoDB pair lock repository", "Serializes overlapping request submission per pair.", $tags="Infrastructure")
    Component(rentalsBridge, "Integration Event Bridge", "RentalIntegrationEventBridge", "Translates post-commit domain events to integration events.", $tags="Infrastructure")
  }
}

Rel(spa, rentalsRest, "Calls", "JSON/HTTPS")
Rel(rentalsRest, rentalsPolicy, "Authorizes through")
Rel(rentalsPolicy, iam, "Reads actor identity")
Rel(rentalsRest, rentalsResources, "Maps")
Rel(rentalsRest, rentalsServices, "Invokes")
Rel(rentalsRest, rentalsErrors, "Maps failures through")
Rel(rentalsCommandImpl, rentalsServices, "Implements command services")
Rel(rentalsCommandImpl, rentalsExecutors, "Delegates transactions to")
Rel(rentalsQueryImpl, rentalsServices, "Implements query flow")
Rel(rentalsExecutors, rentalsAggregates, "Mutates")
Rel(rentalsExecutors, rentalsRecords, "Creates lifecycle records")
Rel(rentalsExecutors, rentalsRepos, "Uses")
Rel(rentalsExecutors, rentalsPorts, "Uses")
Rel(rentalsQueryImpl, rentalsRepos, "Queries")
Rel(rentalsServices, rentalsMessages, "Handles")
Rel(rentalsAggregates, rentalsValues, "Owns")
Rel(rentalsAggregates, rentalsEvents, "Registers")
Rel(rentalsFacadeImpl, rentalsPublished, "Implements")
Rel(rentalsFacadeImpl, rentalsRepos, "Reads history")
Rel(rentalsPersistence, rentalsRepos, "Implements")
Rel(rentalsPersistence, rentalsGuard, "Acquires pair lock")
Rel(rentalsPersistence, db, "Reads and writes", "JPA/SQL")
Rel(rentalsAcl, rentalsPorts, "Implements")
Rel(rentalsAcl, inventory, "Calls equipment facade")
Rel(rentalsAcl, subscriptions, "Calls entitlement facade")
Rel(rentalsPersistence, shared, "Publishes aggregate events")
Rel(shared, rentalsBridge, "Delivers after commit")
Rel(rentalsBridge, rentalsEventContract, "Publishes")
Rel(maintenance, rentalsPublished, "Reads active-rental context")

SHOW_LEGEND()
@enduml
