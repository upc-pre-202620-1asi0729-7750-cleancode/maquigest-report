
@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title MaquiGest - Rentals Backend Component Diagram

Container_Boundary(rentals, "Rentals Bounded Context [Java / Spring Boot]") {

    Boundary(interfaces_layer, "Interfaces Layer") {
        Component(rest, "rest", "REST API Package", "Rental request, rental lifecycle, delivery and return endpoints. Subpackages: resources, security, transform.")
        Component(published_acl, "acl", "Published Rental Contract", "Provides active-rental information to Maintenance.")
        Component(interface_events, "events", "Integration Event Contract", "Defines published rental integration events.")
    }

    Boundary(application_layer, "Application Layer") {
        Component(commands, "commandservices", "Application Contracts", "Defines rental request and lifecycle commands.")
        Component(queries, "queryservices", "Application Contracts", "Defines rental query operations.")
        Component(internal_services, "internal", "Use Case Implementations", "Subpackages: commandservices, queryservices. Coordinates rental transactions and lifecycle operations.")
        Component(ports, "ports", "Outbound Application Contracts", "Defines equipment availability and subscription entitlement capabilities.")
        Component(application_acl, "acl", "Rental Facade Implementation", "Implements the maintenance-facing rental contract.")
        Component(exceptions, "exceptions", "Application Errors", "Defines rental operation failures.")
    }

    Boundary(domain_layer, "Domain Layer") {
        Component(domain_model, "model", "Domain Model", "Subpackages: aggregates, commands, entities, events, queries, valueobjects. Owns rental lifecycle rules.")
        Component(domain_repositories, "repositories", "Repository Contracts", "Defines rental requests, rentals, deliveries and returns persistence.")
    }

    Boundary(infrastructure_layer, "Infrastructure Layer") {
        Component(jpa, "persistence.jpa", "JPA Persistence", "Subpackages: adapters, assemblers, entities, repositories.")
        Component(inventory_acl, "acl.inventory", "Anti-Corruption Layer", "Adapts Inventory equipment capabilities to rental operations.")
        Component(subscriptions_acl, "acl.subscriptions", "Anti-Corruption Layer", "Adapts subscription entitlement decisions to rental operations.")
        Component(event_bridge, "events", "Integration Event Bridge", "Publishes rental integration events after transaction commit.")
    }
}

Rel(rest, commands, "Invokes commands")
Rel(rest, queries, "Invokes queries")

Rel(internal_services, commands, "Implements command contracts")
Rel(internal_services, queries, "Implements query contracts")
Rel(internal_services, domain_model, "Executes rental rules")
Rel(internal_services, domain_repositories, "Uses repositories")
Rel(internal_services, ports, "Requires external capabilities")

Rel(application_acl, published_acl, "Implements published contract")
Rel(application_acl, domain_repositories, "Queries rental records")

Rel(jpa, domain_repositories, "Implements repository contracts")
Rel(inventory_acl, ports, "Implements equipment port")
Rel(subscriptions_acl, ports, "Implements entitlement port")
Rel(event_bridge, interface_events, "Publishes integration events")

Lay_D(rest, commands)
Lay_D(commands, domain_model)
Lay_D(domain_model, jpa)

SHOW_LEGEND()

@enduml