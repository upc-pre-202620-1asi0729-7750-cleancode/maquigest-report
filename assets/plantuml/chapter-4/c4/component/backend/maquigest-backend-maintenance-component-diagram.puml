
@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title MaquiGest - Maintenance Backend Component Diagram

Container_Boundary(maintenance, "Maintenance Bounded Context [Java / Spring Boot]") {

    Boundary(interfaces_layer, "Interfaces Layer") {
        Component(rest, "rest", "REST API Package", "Incident and maintenance endpoints. Subpackages: resources, security, transform.")
        Component(interface_events, "events", "Integration Event Contract", "Defines published maintenance integration events.")
    }

    Boundary(application_layer, "Application Layer") {
        Component(commands, "commandservices", "Application Contracts", "Defines incident and maintenance commands.")
        Component(queries, "queryservices", "Application Contracts", "Defines maintenance query operations.")
        Component(internal_services, "internal", "Use Case Implementations", "Subpackages: commandservices, queryservices. Coordinates maintenance transactions and lifecycle operations.")
        Component(ports, "ports", "Outbound Application Contracts", "Defines required Inventory, Rentals and Subscriptions capabilities.")
        Component(exceptions, "exceptions", "Application Errors", "Defines maintenance operation failures.")
    }

    Boundary(domain_layer, "Domain Layer") {
        Component(domain_model, "model", "Domain Model", "Subpackages: aggregates, commands, entities, events, queries, valueobjects. Owns incident and maintenance lifecycle rules.")
        Component(domain_repositories, "repositories", "Repository Contracts", "Defines incident, maintenance record and activity persistence.")
    }

    Boundary(infrastructure_layer, "Infrastructure Layer") {
        Component(jpa, "persistence.jpa", "JPA Persistence", "Subpackages: adapters, assemblers, entities, repositories.")
        Component(inventory_acl, "acl.inventory", "Anti-Corruption Layer", "Adapts equipment status and availability capabilities.")
        Component(rentals_acl, "acl.rentals", "Anti-Corruption Layer", "Adapts active rental information.")
        Component(subscriptions_acl, "acl.subscriptions", "Anti-Corruption Layer", "Adapts subscription entitlement decisions.")
        Component(event_bridge, "events", "Integration Event Bridge", "Publishes maintenance integration events after transaction commit.")
    }
}

Rel(rest, commands, "Invokes commands")
Rel(rest, queries, "Invokes queries")

Rel(internal_services, commands, "Implements command contracts")
Rel(internal_services, queries, "Implements query contracts")
Rel(internal_services, domain_model, "Executes maintenance rules")
Rel(internal_services, domain_repositories, "Uses repositories")
Rel(internal_services, ports, "Requires external capabilities")

Rel(jpa, domain_repositories, "Implements repository contracts")
Rel(inventory_acl, ports, "Implements equipment port")
Rel(rentals_acl, ports, "Implements rental port")
Rel(subscriptions_acl, ports, "Implements entitlement port")

Rel(event_bridge, interface_events, "Publishes integration events")

Lay_D(rest, commands)
Lay_D(commands, domain_model)
Lay_D(domain_model, jpa)

SHOW_LEGEND()

@enduml