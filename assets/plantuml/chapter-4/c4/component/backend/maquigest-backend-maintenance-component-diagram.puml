@startuml
!include _includes/C4_Component.puml
LAYOUT_TOP_DOWN()
AddElementTag("Interfaces", $bgColor="#D6EAF8", $borderColor="#2471A3")
AddElementTag("Application", $bgColor="#D5F5E3", $borderColor="#1E8449")
AddElementTag("Domain", $bgColor="#FCF3CF", $borderColor="#B7950B")
AddElementTag("Infrastructure", $bgColor="#F5EEF8", $borderColor="#7D3C98")
title MaquiGest - Maintenance Layered Component Diagram

Container(spa, "MaquiGest Web Application", "Angular", "Consumes Maintenance REST endpoints.")
System_Ext(iam, "IAM Actor Contract", "Published actor identity.")
System_Ext(inventory, "Inventory Published Contract", "Equipment inspection and status facade.")
System_Ext(rentals, "Rentals Published Contract", "Active-rental context facade.")
System_Ext(subscriptions, "Subscriptions Published Contract", "Maintenance entitlement facade.")
System_Ext(shared, "Shared Event Publication", "In-process post-commit event delivery.")
ContainerDb(db, "MaquiGest Database", "MySQL", "Stores maintenance tables.")

Container_Boundary(context, "Maintenance Bounded Context") {
  Boundary(interfaces_layer, "Interfaces Layer") {
    Component(maintenanceRest, "REST Interface", "IncidentController, MaintenanceController", "Exposes incident, maintenance and history endpoints.", $tags="Interfaces")
    Component(maintenancePolicy, "Actor Policy", "MaintenanceActorPolicy", "Resolves and validates the authenticated actor.", $tags="Interfaces")
    Component(maintenanceResources, "Resources and Assemblers", "resources / transform", "Maps HTTP resources and domain results.", $tags="Interfaces")
    Component(maintenanceErrors, "REST Error Boundary", "MaintenanceExceptionHandler", "Maps application errors to HTTP problem details.", $tags="Interfaces")
    Component(maintenanceEventContract, "Integration Event Contract", "MaintenanceIntegrationEvent", "Published language for maintenance changes.", $tags="Interfaces")
  }
  Boundary(application_layer, "Application Layer") {
    Component(maintenanceServices, "Service Contracts", "incident/maintenance command services, query service", "Defines maintenance use cases.", $tags="Application")
    Component(maintenanceCommandImpl, "Command Service Implementations", "IncidentCommandServiceImpl, MaintenanceCommandServiceImpl", "Converts transactional failures into application results.", $tags="Application")
    Component(maintenanceExecutors, "Transactional Executors", "incident and maintenance executors", "Coordinates aggregate and cross-context mutations atomically.", $tags="Application")
    Component(maintenanceQueryImpl, "Query Service Implementation", "MaintenanceQueryServiceImpl", "Builds maintenance and equipment history views.", $tags="Application")
    Component(maintenancePorts, "External Context Ports", "inventory, rentals and subscription ports", "Defines capabilities required from other contexts.", $tags="Application")
  }
  Boundary(domain_layer, "Domain Layer") {
    Component(maintenanceAggregates, "Maintenance Aggregates", "Incident, Maintenance", "Protects incident and maintenance lifecycle invariants.", $tags="Domain")
    Component(maintenanceActivity, "Activity Record", "MaintenanceActivity", "Stores immutable activity history identified by maintenanceId.", $tags="Domain")
    Component(maintenanceValues, "Value Objects and Enums", "MaintenanceType, statuses", "Represents maintenance types and lifecycle states.", $tags="Domain")
    Component(maintenanceMessages, "Commands and Queries", "maintenance commands and queries", "Expresses maintenance mutations and reads.", $tags="Domain")
    Component(maintenanceEvents, "Domain Events", "incident and maintenance events", "Records relevant aggregate transitions.", $tags="Domain")
    Component(maintenanceRepos, "Repository Ports", "incident, maintenance and activity repositories", "Defines persistence contracts owned by Domain.", $tags="Domain")
  }
  Boundary(infrastructure_layer, "Infrastructure Layer") {
    Component(maintenancePersistence, "JPA Persistence Adapters", "RepositoryImpl, entities, assemblers", "Implements maintenance repository ports and mappings.", $tags="Infrastructure")
    Component(maintenanceAcl, "ACL Adapters", "Inventory, Rentals and Subscription adapters", "Implements external ports using published facades.", $tags="Infrastructure")
    Component(maintenanceBridge, "Integration Event Bridge", "MaintenanceIntegrationEventBridge", "Translates post-commit domain events to integration events.", $tags="Infrastructure")
  }
}

Rel(spa, maintenanceRest, "Calls", "JSON/HTTPS")
Rel(maintenanceRest, maintenancePolicy, "Authorizes through")
Rel(maintenancePolicy, iam, "Reads actor identity")
Rel(maintenanceRest, maintenanceResources, "Maps")
Rel(maintenanceRest, maintenanceServices, "Invokes")
Rel(maintenanceRest, maintenanceErrors, "Maps failures through")
Rel(maintenanceCommandImpl, maintenanceServices, "Implements command services")
Rel(maintenanceCommandImpl, maintenanceExecutors, "Delegates transactions to")
Rel(maintenanceQueryImpl, maintenanceServices, "Implements query flow")
Rel(maintenanceExecutors, maintenanceAggregates, "Mutates")
Rel(maintenanceExecutors, maintenanceActivity, "Records activity")
Rel(maintenanceExecutors, maintenanceRepos, "Uses")
Rel(maintenanceExecutors, maintenancePorts, "Uses")
Rel(maintenanceQueryImpl, maintenanceRepos, "Queries")
Rel(maintenanceQueryImpl, maintenancePorts, "Uses")
Rel(maintenanceServices, maintenanceMessages, "Handles")
Rel(maintenanceAggregates, maintenanceValues, "Uses")
Rel(maintenanceActivity, maintenanceValues, "Uses status")
Rel(maintenanceAggregates, maintenanceEvents, "Registers")
Rel(maintenancePersistence, maintenanceRepos, "Implements")
Rel(maintenancePersistence, db, "Reads and writes", "JPA/SQL")
Rel(maintenanceAcl, maintenancePorts, "Implements")
Rel(maintenanceAcl, inventory, "Calls equipment facade")
Rel(maintenanceAcl, rentals, "Calls rental-context facade")
Rel(maintenanceAcl, subscriptions, "Calls entitlement facade")
Rel(maintenancePersistence, shared, "Publishes aggregate events")
Rel(shared, maintenanceBridge, "Delivers after commit")
Rel(maintenanceBridge, maintenanceEventContract, "Publishes")

SHOW_LEGEND()
@enduml
