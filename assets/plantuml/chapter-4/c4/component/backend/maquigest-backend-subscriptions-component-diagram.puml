
@startuml
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()

title MaquiGest - Subscriptions Backend Component Diagram

Container_Boundary(subscriptions, "Subscriptions Bounded Context [Java / Spring Boot]") {

    Boundary(interfaces_layer, "Interfaces Layer") {
        Component(rest, "rest", "REST API Package", "Subscription plan and user subscription endpoints. Subpackages: resources, security, transform.")
        Component(published_acl, "acl", "Published Subscription Contract", "Exposes entitlement decisions to other bounded contexts.")
    }

    Boundary(application_layer, "Application Layer") {
        Component(commands, "commandservices", "Application Contracts", "Defines subscription lifecycle commands.")
        Component(queries, "queryservices", "Application Contracts", "Defines plan and user subscription queries.")
        Component(internal_services, "internal", "Use Case Implementations", "Subpackages: commandservices, queryservices. Coordinates subscription operations.")
        Component(ports, "ports", "Outbound Application Contract", "Defines required subscriber identity capabilities.")
        Component(application_acl, "acl", "Subscription Facade Implementation", "Implements the published entitlement contract.")
    }

    Boundary(domain_layer, "Domain Layer") {
        Component(domain_model, "model", "Domain Model", "Subpackages: aggregates, commands, events, queries, valueobjects. Owns plan and subscription rules.")
        Component(domain_repositories, "repositories", "Repository Contracts", "Defines plan and user subscription persistence.")
    }

    Boundary(infrastructure_layer, "Infrastructure Layer") {
        Component(jpa, "persistence.jpa", "JPA Persistence", "Subpackages: adapters, assemblers, entities, repositories. Maps and persists subscriptions.")
        Component(jpa_seed, "persistence.jpa.seed", "Catalog Initialization", "Initializes subscription plans when the application starts.")
        Component(iam_acl, "acl.iam", "Anti-Corruption Layer", "Adapts IAM subscriber information to the application port.")
    }
}

Rel(rest, commands, "Invokes commands")
Rel(rest, queries, "Invokes queries")

Rel(internal_services, commands, "Implements command contract")
Rel(internal_services, queries, "Implements query contracts")
Rel(internal_services, domain_model, "Executes subscription rules")
Rel(internal_services, domain_repositories, "Uses repositories")
Rel(internal_services, ports, "Requires subscriber identity")

Rel(application_acl, published_acl, "Implements entitlement contract")
Rel(application_acl, domain_repositories, "Checks subscription records")

Rel(jpa, domain_repositories, "Implements repository contracts")
Rel(jpa_seed, jpa, "Initializes plan catalog")
Rel(iam_acl, ports, "Implements subscriber identity port")

Lay_D(rest, commands)
Lay_D(commands, domain_model)
Lay_D(domain_model, jpa)

SHOW_LEGEND()

@enduml