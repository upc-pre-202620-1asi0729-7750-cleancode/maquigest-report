@startuml
!include _includes/C4_Component.puml
LAYOUT_TOP_DOWN()
AddElementTag("Interfaces", $bgColor="#D6EAF8", $borderColor="#2471A3")
AddElementTag("Application", $bgColor="#D5F5E3", $borderColor="#1E8449")
AddElementTag("Domain", $bgColor="#FCF3CF", $borderColor="#B7950B")
AddElementTag("Infrastructure", $bgColor="#F5EEF8", $borderColor="#7D3C98")
title MaquiGest - Subscriptions Layered Component Diagram

Container(spa, "MaquiGest Web Application", "Angular", "Consumes Subscriptions REST endpoints.")
System_Ext(iam, "IAM Published Contracts", "Actor and subscriber identity.")
System_Ext(rentals, "Rentals Bounded Context", "Consumes rental entitlement.")
System_Ext(maintenance, "Maintenance Bounded Context", "Consumes maintenance entitlement.")
ContainerDb(db, "MaquiGest Database", "MySQL", "Stores subscription tables.")

Container_Boundary(context, "Subscriptions Bounded Context") {
  Boundary(interfaces_layer, "Interfaces Layer") {
    Component(subscriptionsRest, "REST Interface", "plan and subscription controllers", "Exposes plan and user-subscription endpoints.", $tags="Interfaces")
    Component(subscriptionsPolicy, "Ownership Policy", "SubscriptionOwnershipPolicy", "Validates actor identity and subscription ownership.", $tags="Interfaces")
    Component(subscriptionsResources, "Resources and Assemblers", "resources / transform", "Maps HTTP resources and domain results.", $tags="Interfaces")
    Component(subscriptionsPublished, "Published Entitlement Contract", "SubscriptionsContextFacade", "Publishes rental and maintenance entitlement decisions.", $tags="Interfaces")
  }
  Boundary(application_layer, "Application Layer") {
    Component(subscriptionsServices, "Service Contracts", "command and query services", "Defines subscription use cases.", $tags="Application")
    Component(subscriptionsImpl, "Service Implementations", "internal command/query services", "Coordinates subscription changes and queries.", $tags="Application")
    Component(subscriptionsIamPort, "IAM Subscriber Port", "IamSubscriberPort", "Defines subscriber information required from IAM.", $tags="Application")
    Component(subscriptionsFacadeImpl, "Entitlement Facade Implementation", "SubscriptionsContextFacadeImpl", "Implements the published entitlement contract.", $tags="Application")
  }
  Boundary(domain_layer, "Domain Layer") {
    Component(subscriptionsAggregates, "Subscription Aggregates", "SubscriptionPlan, UserSubscription", "Protects plan and subscription lifecycle invariants.", $tags="Domain")
    Component(subscriptionsValues, "Value Objects and Enums", "SubscriptionPrice, SubscriptionPeriod, statuses", "Represents price, active periods and lifecycle states.", $tags="Domain")
    Component(subscriptionsMessages, "Commands and Queries", "subscription commands and queries", "Expresses subscription mutations and reads.", $tags="Domain")
    Component(subscriptionsEvents, "Domain Events", "activated and cancelled events", "Records relevant subscription transitions.", $tags="Domain")
    Component(subscriptionsRepos, "Repository Ports", "SubscriptionPlanRepository, UserSubscriptionRepository", "Defines persistence contracts owned by Domain.", $tags="Domain")
  }
  Boundary(infrastructure_layer, "Infrastructure Layer") {
    Component(subscriptionsPersistence, "JPA Persistence Adapters", "RepositoryImpl, entities, assemblers", "Implements subscription repository ports and mappings.", $tags="Infrastructure")
    Component(subscriptionsIamAcl, "IAM ACL Adapter", "IamSubscriberAclAdapter", "Implements the subscriber port using the IAM facade.", $tags="Infrastructure")
    Component(subscriptionsSeed, "Plan Seed", "SubscriptionPlanSeed", "Creates the initial subscription plan catalog.", $tags="Infrastructure")
  }
}

Rel(spa, subscriptionsRest, "Calls", "JSON/HTTPS")
Rel(subscriptionsRest, subscriptionsPolicy, "Authorizes through")
Rel(subscriptionsPolicy, iam, "Reads actor identity")
Rel(subscriptionsRest, subscriptionsResources, "Maps")
Rel(subscriptionsRest, subscriptionsServices, "Invokes")
Rel(subscriptionsImpl, subscriptionsServices, "Implements")
Rel(subscriptionsImpl, subscriptionsAggregates, "Executes behavior")
Rel(subscriptionsImpl, subscriptionsRepos, "Uses")
Rel(subscriptionsImpl, subscriptionsIamPort, "Uses")
Rel(subscriptionsServices, subscriptionsMessages, "Handles")
Rel(subscriptionsAggregates, subscriptionsValues, "Owns")
Rel(subscriptionsAggregates, subscriptionsEvents, "Registers")
Rel(subscriptionsFacadeImpl, subscriptionsPublished, "Implements")
Rel(subscriptionsFacadeImpl, subscriptionsAggregates, "Evaluates plan semantics")
Rel(subscriptionsFacadeImpl, subscriptionsRepos, "Reads plans and subscriptions")
Rel(subscriptionsPersistence, subscriptionsRepos, "Implements")
Rel(subscriptionsPersistence, db, "Reads and writes", "JPA/SQL")
Rel(subscriptionsIamAcl, subscriptionsIamPort, "Implements")
Rel(subscriptionsIamAcl, iam, "Calls subscriber facade")
Rel(subscriptionsSeed, subscriptionsPersistence, "Seeds plan catalog")
Rel(rentals, subscriptionsPublished, "Checks rental entitlement")
Rel(maintenance, subscriptionsPublished, "Checks maintenance entitlement")

SHOW_LEGEND()
@enduml
