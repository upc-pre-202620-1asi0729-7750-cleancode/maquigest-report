@startuml
!include _includes/C4_Component.puml
title MaquiGest - Subscriptions Backend Component Diagram
Container(spa, "MaquiGest Web Application", "Angular", "Subscriptions REST client")
Container_Ext(iam, "IAM Bounded Context", "Published IAM contracts", "Provides actor and subscriber identity.")
Container_Ext(rentals, "Rentals Bounded Context", "Backend context", "Consumes subscription entitlement.")
Container_Ext(maintenance, "Maintenance Bounded Context", "Backend context", "Consumes maintenance entitlement.")
Container_Ext(shared, "Shared Domain Event Publisher", "Spring ApplicationEventPublisher", "Publishes aggregate events in process.")
Container_Boundary(subscriptions, "Subscriptions Bounded Context [Java / Spring Boot]") {
 Component(rest, "Subscriptions REST Interface", "Plan / user-subscription controllers", "Exposes plan and subscription endpoints.")
 Component(policy, "Subscription Ownership Policy", "SubscriptionOwnershipPolicy", "Checks subscription ownership through IAM actor identity.")
 Component(app, "Subscription Application Services", "Command and query services", "Coordinates creation, plan changes, cancellation and queries.")
 Component(domain, "Subscriptions Domain", "SubscriptionPlan / UserSubscription / value objects", "Enforces plan and subscription lifecycle rules.")
 Component(repoPorts, "Domain Repository Ports", "Plan / user-subscription repositories", "Defines persistence contracts owned by Domain.")
 Component(iamPort, "IAM Subscriber Port", "IamSubscriberPort", "Defines subscriber information required by Application.")
 Component(iamAdapter, "IAM Subscriber ACL Adapter", "IamSubscriberAclAdapter", "Implements the IAM port using the published subscriber facade.")
 Component(facade, "Subscriptions Context Facade", "SubscriptionsContextFacadeImpl", "Publishes entitlement decisions to Rentals and Maintenance.")
 Component(persistence, "Subscriptions Persistence Adapters", "RepositoryImpl / assemblers / JPA", "Implements subscription repository ports.")
 Component(seed, "Subscription Plan Seed", "SubscriptionPlanSeed", "Seeds available plans through persistence.")
}
ContainerDb(db, "MaquiGest Database", "MySQL", "Subscription plan and user-subscription tables")
Rel(spa, rest, "Calls", "JSON/HTTPS")
Rel(rest, policy, "Authorizes through")
Rel(policy, iam, "Reads actor identity")
Rel(rest, app, "Delegates")
Rel(app, domain, "Executes")
Rel(app, repoPorts, "Uses")
Rel(app, iamPort, "Uses")
Rel(iamAdapter, iamPort, "Implements")
Rel(iamAdapter, iam, "Calls subscriber facade")
Rel(rentals, facade, "Checks rental entitlement")
Rel(maintenance, facade, "Checks maintenance entitlement")
Rel(facade, domain, "Evaluates plan semantics")
Rel(facade, repoPorts, "Reads subscriptions and plans")
Rel(persistence, repoPorts, "Implements")
Rel(persistence, db, "Reads and writes", "JPA/SQL")
Rel(persistence, shared, "Publishes subscription domain events through")
Rel(seed, persistence, "Seeds plans")
SHOW_LEGEND()
@enduml
